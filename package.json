{
    "name": "cloudflare-workers-proxies",
    "version": "1.0.0-alpha.1",
    "description": "Use HTTP, HTTPS & SOCKS5 proxies in workers fetch()",
    "repository": "timo972/cloudflare-workers-http-proxy",
    "license": "MIT",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./socks5": {
            "types": "./dist/socks5/index.d.mts",
            "import": "./dist/socks5/index.mjs"
        },
        "./http": {
            "types": "./dist/http/index.d.mts",
            "import": "./dist/http/index.mjs"
        },
        "./https": {
            "types": "./dist/https/index.d.mts",
            "import": "./dist/https/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "obuild",
        "dev": "vitest",
        "lint": "eslint . && prettier -c src test examples",
        "lint:fix": "eslint --fix . && prettier -w src test examples",
        "prepack": "pnpm build",
        "release": "pnpm test && pnpm build && changelogen --release --prerelease --publish --publishTag alpha --push",
        "test": "pnpm lint && vitest run --coverage"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260729.1",
        "@types/node": "^24.9.2",
        "@vitest/coverage-v8": "^4.0.5",
        "automd": "^0.4.2",
        "changelogen": "^0.6.2",
        "eslint": "^9.38.0",
        "eslint-config-unjs": "^0.5.0",
        "h3": "^2.0.1-rc.5",
        "obuild": "^0.3.2",
        "prettier": "^3.6.2",
        "typescript": "^5.9.3",
        "undici": "^7.16.0",
        "vitest": "^4.0.5"
    },
    "packageManager": "pnpm@11.13.1"
}